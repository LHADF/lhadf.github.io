      },
      {
       "texto": "a ti, Dios mío;",
       "sangria": 1
      }
     ],
     [
      {
       "texto": "tiene sed de Dios,",
       "sangria": 0
      },
      {
       "texto": "del Dios vivo:",
       "sangria": 1
      },
      {
       "texto": "¿cuándo entraré a ver",
       "sangria": 1
      },
      {
       "texto": "el rostro de Dios?",
       "sangria": 1
      }
     ],
     [
      {
       "texto": "Las lágrimas son mi pan",
       "sangria": 0
      },
      {
       "texto": "noche y día.",
       "sangria": 1
      },
      {
       "texto": "mientras todo el día me repiten:",
       "sangria": 1
      },
      {
       "texto": "\"¿Dónde está tu Dios?\"",
       "sangria": 1
      }
     ],
     [
      {
       "texto": "Recuerdo otros tiempos,",
       "sangria": 0
      },
      {
       "texto": "y desahogo mi alma conmigo:",
       "sangria": 1
      },
      {
       "texto": "cómo marchaba a la cabeza del grupo,",
       "sangria": 1
      },
      {
       "texto": "hacia la casa de Dios,",
       "sangria": 1
      },
      {
       "texto": "entre cantos de júbilo y alabanza,",
       "sangria": 1
      },
      {
       "texto": "en el bullicio de la fiesta.",
       "sangria": 1
      }
     ],
     [
      {
       "texto": "¿Por qué te acongojas, alma mía,",
       "sangria": 0
      },
      {
       "texto": "por qué te me turbas?",
       "sangria": 1
      },
      {
       "texto": "Espera en Dios que volverás a alabarlo:",
       "sangria": 1
      },
      {
       "texto": "\"Salud de mi rostro, Dios mío\".",
       "sangria": 1
      }
     ],
     [
      {
       "texto": "Cuando mi alma se acongoja,",
       "sangria": 0
      },
      {
       "texto": "te recuerdo",
       "sangria": 1
      },
      {
       "texto": "desde el Jordán y el Hermón",
       "sangria": 1
      },
      {
       "texto": "y el Monte Menor.",
       "sangria": 1
      }
     ],
     [
      {
       "texto": "Una sima grita a otra sima",
       "sangria": 0
      },
      {
       "texto": "con voz de cascadas:",
       "sangria": 1
      },
      {
       "texto": "tus torrentes y tus olas",
       "sangria": 1
      },
      {
       "texto": "me han arrollado.",
       "sangria": 1
      }
     ],
     [
      {
       "texto": "De día el Señor",
       "sangria": 0
      },
      {
       "texto": "me hará misericordia,",
       "sangria": 1
      },
      {
       "texto": "de noche cantaré la alabanza",
       "sangria": 1
      },
      {
       "texto": "del Dios de mi vida.",
       "sangria": 1
      }
     ],
     [
      {
       "texto": "Diré a Dios: \"Roca mía,",
       "sangria": 0
