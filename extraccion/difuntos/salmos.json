 {
  "id": "salmo-145",
  "cita": "Salmo 145",
  "titulo": "FELICIDAD DE LOS QUE ESPERAN EN DIOS",
  "sentencia": null,
  "partes": [
   {
    "numero": null,
    "estrofas": [
     [
      {
       "texto": "Alaba, alma mía, al Señor:",
       "sangria": 0
      },
      {
       "texto": "alabaré al Señor mientras viva,",
       "sangria": 1
      },
      {
       "texto": "tañeré para mi Dios mientras exista.",
       "sangria": 1
      }
     ],
     [
      {
       "texto": "No confiéis en los príncipes,",
       "sangria": 0
      },
      {
       "texto": "seres de polvo que no pueden salvar;",
       "sangria": 1
      },
      {
       "texto": "exhalan el espíritu y vuelven al polvo,",
       "sangria": 1
