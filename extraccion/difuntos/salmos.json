      {
       "texto": "no me quites tu santo espíritu.",
       "sangria": 1
      }
     ],
     [
      {
       "texto": "Devuélveme la alegría de tu salvación,",
       "sangria": 0
      },
      {
       "texto": "afiánzame con espíritu generoso:",
       "sangria": 1
      },
      {
       "texto": "enseñaré a los malvados tus caminos,",
       "sangria": 1
      },
      {
       "texto": "los pecadores volverán a ti.",
       "sangria": 1
      }
     ],
     [
      {
       "texto": "Líbrame de la sangre, oh Dios,",
       "sangria": 0
      },
      {
       "texto": "Dios, Salvador mío,",
       "sangria": 1
      },
      {
       "texto": "y cantará mi lengua tu justicia.",
