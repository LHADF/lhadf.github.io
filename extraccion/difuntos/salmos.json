 {
  "id": "salmo-50",
  "cita": "Salmo 50",
  "titulo": "MISERICORDIA, DIOS MÍO",
  "sentencia": null,
  "partes": [
   {
    "numero": null,
    "estrofas": [
     [
      {
       "texto": "Misericordia, Dios mío, por tu bondad,",
       "sangria": 0
      },
      {
       "texto": "por tu inmensa compasión borra mi culpa;",
       "sangria": 1
