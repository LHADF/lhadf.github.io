  "sentencia": null,
  "partes": [
   {
    "numero": null,
    "estrofas": [
     [
      {
       "texto": "Como busca la cierva",
       "sangria": 0
      },
      {
       "texto": "corrientes de agua,",
       "sangria": 1
      },
      {
       "texto": "así mi alma te busca",
