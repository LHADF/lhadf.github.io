      },
      {
       "texto": "¿Por qué voy andando, sombrío,",
       "sangria": 1
      },
      {
       "texto": "hostigado por mi enemigo?\"",
       "sangria": 1
      }
     ],
     [
      {
       "texto": "Se me rompen los huesos",
       "sangria": 0
      },
      {
       "texto": "por las burlas del adversario;",
       "sangria": 1
      },
      {
       "texto": "todo el día me preguntan:",
       "sangria": 1
      },
      {
       "texto": "\"¿Dónde está tu Dios?\"",
       "sangria": 1
      },
      {
       "texto": "¿Por qué te acongojas, alma mía,",
       "sangria": 0
      },
      {
       "texto": "por qué te me turbas?",
       "sangria": 1
      },
      {
       "texto": "Espera en Dios que volverás a alabarlo:",
       "sangria": 1
      },
      {
       "texto": "\"Salud de mi rostro, Dios mío\".",
       "sangria": 1
      }
     ]
    ]
