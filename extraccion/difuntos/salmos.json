[
 {
  "id": "salmo-39-2-14-17-18",
  "cita": "Salmo 39, 2-14. 17-18",
  "titulo": "EL JUSTO ESPERA EN EL SEÑOR",
  "sentencia": null,
  "gloria": true,
  "partes": [
   {
    "numero": "I",
    "estrofas": [
     [
      {
       "texto": "Yo esperaba con ansia al Señor;",
       "sangria": 0
      },
      {
       "texto": "él se inclinó y escuchó mi grito:",
       "sangria": 1
      }
     ],
     [
      {
       "texto": "me levantó de la fosa fatal,",
       "sangria": 0
      },
      {
       "texto": "de la charca fangosa;",
       "sangria": 1
      },
      {
       "texto": "afianzó mis pies sobre roca,",
       "sangria": 1
      },
      {
       "texto": "y aseguró mis pasos;",
       "sangria": 1
      }
     ],
     [
      {
       "texto": "me puso en la boca un cántico nuevo,",
       "sangria": 0
      },
      {
       "texto": "un himno a nuestro Dios.",
       "sangria": 1
      },
      {
       "texto": "Muchos, al verlo, quedaron sobrecogidos",
       "sangria": 1
      },
      {
       "texto": "y confiaron en el Señor.",
       "sangria": 1
      }
     ],
     [
      {
       "texto": "Dichoso el hombre que ha puesto",
       "sangria": 0
      },
      {
       "texto": "su confianza en el Señor,",
       "sangria": 1
      },
      {
       "texto": "y no acude a los idólatras,",
       "sangria": 1
      },
      {
       "texto": "que se extravían con engaños.",
       "sangria": 1
      }
     ],
     [
      {
       "texto": "Cuántas maravillas has hecho,",
       "sangria": 0
      },
      {
       "texto": "Señor, Dios mío,",
       "sangria": 1
      },
      {
       "texto": "cuántos planes en favor nuestro;",
       "sangria": 1
      },
      {
       "texto": "nadie se te puede comparar.",
       "sangria": 1
      },
      {
       "texto": "Intento proclamarlas, decirlas,",
       "sangria": 1
      },
      {
       "texto": "pero superan todo número.",
       "sangria": 1
      }
     ],
     [
      {
       "texto": "Tú no quieres sacrificios ni ofrendas,",
       "sangria": 0
      },
      {
       "texto": "y, en cambio, me abriste el oído;",
       "sangria": 1
      },
      {
       "texto": "no pides sacrificio expiatorio,",
       "sangria": 1
      },
      {
       "texto": "entonces yo digo: \"Aquí estoy",
       "sangria": 1
      },
      {
       "texto": "—como está escrito en mi libro—",
       "sangria": 1
      },
      {
       "texto": "para hacer tu voluntad\".",
       "sangria": 1
      }
     ],
     [
      {
       "texto": "Dios mío, lo quiero,",
       "sangria": 0
      },
      {
       "texto": "y llevo tu ley en las entrañas.",
       "sangria": 1
      }
     ]
    ]
   },
   {
    "numero": "II",
    "estrofas": [
     [
      {
       "texto": "He proclamado tu salvación",
       "sangria": 0
      },
      {
       "texto": "ante la gran asamblea;",
       "sangria": 1
      },
      {
       "texto": "no he cerrado los labios:",
       "sangria": 1
      },
      {
       "texto": "Señor, tú lo sabes.",
       "sangria": 1
      }
     ],
     [
      {
       "texto": "No me he guardado en el pecho tu defensa,",
       "sangria": 0
      },
      {
       "texto": "he contado tu fidelidad y tu salvación,",
       "sangria": 1
      },
      {
       "texto": "no he negado tu misericordia y tu lealtad",
       "sangria": 1
      },
      {
       "texto": "ante la gran asamblea.",
       "sangria": 1
      }
     ],
     [
      {
       "texto": "Tú, Señor, no me cierres tus entrañas,",
       "sangria": 0
      },
      {
       "texto": "que tu misericordia y tu lealtad",
       "sangria": 1
      },
      {
       "texto": "me guarden siempre,",
       "sangria": 1
      },
      {
       "texto": "porque me cercan desgracias sin cuento.",
       "sangria": 1
      }
     ],
     [
      {
       "texto": "Se me echan encima mis culpas,",
       "sangria": 0
      },
      {
       "texto": "y no puedo huir;",
       "sangria": 1
      },
      {
       "texto": "son más que los pelos de mi cabeza,",
       "sangria": 1
      },
      {
       "texto": "y me falta el valor.",
       "sangria": 1
      }
     ],
     [
      {
       "texto": "Señor, dígnate librarme;",
       "sangria": 0
      },
      {
       "texto": "Señor, date prisa en socorrerme.",
       "sangria": 1
      }
     ],
     [
      {
       "texto": "Alégrense y gocen contigo",
       "sangria": 0
      },
      {
       "texto": "todos los que te buscan;",
       "sangria": 1
      },
      {
       "texto": "digan siempre: \"Grande es el Señor\"",
       "sangria": 1
      },
      {
       "texto": "los que desean tu salvación.",
       "sangria": 1
      }
     ],
     [
      {
       "texto": "Yo soy pobre y desgraciado,",
       "sangria": 0
      },
      {
       "texto": "pero el Señor se cuida de mí;",
       "sangria": 1
      },
      {
       "texto": "tú eres mi auxilio y mi liberación:",
       "sangria": 1
      },
      {
       "texto": "Dios mío, no tardes.",
       "sangria": 1
      }
     ]
    ]
   }
