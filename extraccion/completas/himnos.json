     "texto": "Tú aliviarás el último cansancio,",
     "sangria": 0
    },
    {
     "texto": "Tú cuidarás los sueños de la noche,",
     "sangria": 0
    },
    {
     "texto": "Tú borrarás las huellas de mi llanto.",
     "sangria": 0
    }
   ],
   [
    {
     "texto": "Tú nos darás mañana nuevamente",
     "sangria": 0
    },
    {
     "texto": "La antorcha de la luz y la alegría,",
     "sangria": 0
    },
    {
     "texto": "Y, por las horas que te traigo muertas,",
     "sangria": 0
    },
    {
     "texto": "Tú me darás una mañana viva.",
     "sangria": 0
    }
   ]
