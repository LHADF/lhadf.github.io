     "sangria": 0
    },
    {
     "texto": "Sin cogerse de la mano de su madre,",
     "sangria": 0
    },
    {
     "texto": "Así mi corazón viene a ponerse",
     "sangria": 0
    },
    {
     "texto": "Sobre tus manos al caer la tarde",
     "sangria": 0
    }
   ],
   [
    {
     "texto": "Como el niño que no sabe que alguien vela",
     "sangria": 0
    },
    {
     "texto": "Su sueño de inocencia y de esperanza,",
     "sangria": 0
    },
    {
     "texto": "Así descansará mi alma segura,",
     "sangria": 0
    },
    {
     "texto": "Sabiendo que eres tú quien nos aguarda.",
     "sangria": 0
    }
   ],
   [
