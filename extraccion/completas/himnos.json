  "estrofas": [
   [
    {
     "texto": "El sueño, hermano de la muerte,",
     "sangria": 2
    },
    {
     "texto": "a su descanso nos convida;",
     "sangria": 2
    },
    {
     "texto": "guárdanos tú, Señor, de suerte",
     "sangria": 2
    },
    {
     "texto": "que despertemos a la vida.",
     "sangria": 2
    }
   ],
   [
    {
     "texto": "Tu amor nos guía y nos reprende",
     "sangria": 0
    },
    {
     "texto": "y por nosotros se desvela,",
     "sangria": 0
    },
    {
     "texto": "del enemigo nos defiende",
     "sangria": 0
    },
    {
     "texto": "y, mientras dormimos, nos vela.",
     "sangria": 0
    }
   ],
   [
    {
     "texto": "Te ofrecemos, humildemente,",
     "sangria": 0
    },
    {
     "texto": "dolor, trabajo y alegría;",
     "sangria": 0
    },
    {
     "texto": "nuestra plegaria balbuciente:",
     "sangria": 0
    },
    {
     "texto": "\"Gracias, Señor, por este día\".",
     "sangria": 0
    }
   ],
   [
    {
     "texto": "Recibe, Padre, la alabanza",
     "sangria": 0
    },
    {
     "texto": "del corazón que en ti confía",
     "sangria": 0
    },
    {
     "texto": "y alimenta nuestra esperanza",
     "sangria": 0
    },
    {
     "texto": "de amanecer a tu gran día.",
     "sangria": 0
    }
   ],
   [
    {
     "texto": "Gloria a Dios Padre, que nos hizo,",
     "sangria": 0
    },
    {
     "texto": "gloria a Dios Hijo Salvador,",
     "sangria": 0
    },
    {
     "texto": "gloria al Espíritu divino:",
     "sangria": 0
    },
    {
     "texto": "tres Personas y un solo Dios.",
     "sangria": 0
    }
   ]
  ],
