  "primer_verso": "Victoria, tú reinarás.",
  "estrofas": [
   [
    {
     "texto": "Victoria, tú reinarás.",
     "sangria": 0
    },
    {
     "texto": "¡Oh Cruz, tú nos salvarás!",
     "sangria": 0
    }
   ],
   [
    {
     "texto": "El Verbo en ti clavado, muriendo, nos rescató;",
     "sangria": 0
